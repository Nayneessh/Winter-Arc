<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A dark splash ground so the very first frame is already the app's colour, never a
         white flash. Compose supplies everything else. -->
    <style name="Theme.WinterArc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
