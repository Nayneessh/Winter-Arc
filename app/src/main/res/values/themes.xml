<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash/window background matches the app's night-green ground so launch has no flash. -->
    <style name="Theme.WinterArc" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
